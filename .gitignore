# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

terraform.tfstate
terraform.tfstate.backup
.terraform.lock.hcl


# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files as they are usually local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Mac settings
.DS_Store

# Editor directories
.vscode/
.idea/

# Terraform
*.tfplan
*.tfr

# Ansible
*.retry
inventory.ini

# SSH Keys (Security)
*.pem
id_rsa
id_rsa.pub
known_hosts
